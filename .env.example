# Copy this file to .env locally. Never commit or share the filled .env.
# CLI reads .env in the current directory; shell settings take precedence.
RUNPOD_API_KEY=
MLFLOW_TRACKING_URI=https://mlflow.kbiofoundry.kr
FACTORY_MLFLOW_ARTIFACT_LOCATION=mlflow-artifacts:/llm-tuning-factory
# Optional operator label shown in common MLflow records. Do not use a secret here.
FACTORY_OPERATOR=
# Use either OIDC credentials below or an externally issued tracking token.
MLFLOW_TRACKING_TOKEN=
MLFLOW_OIDC_TOKEN_URL=https://sso.k-biofoundrycopilot.duckdns.org/realms/kbf/protocol/openid-connect/token
MLFLOW_OIDC_CLIENT_ID=mlflow
MLFLOW_OIDC_CLIENT_SECRET=
# SSH key path is passed to work --key-file; add verified Pod host key to known_hosts first.
